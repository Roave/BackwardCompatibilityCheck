{
    "extensions": [
        "bcmath", "pcov"
    ],
    "ignore_php_platform_requirements": {
        "8.5": true
    },
    "ini": [
        "memory_limit=-1"
    ],
    "exclude": [
        {"name": "Infection"},
        {"name": "PHPUnit [8.4, lowest]"}
    ],
    "additional_checks": [
        {
            "name": "Infection (PCOV)",
            "job": {
                "php": "@lowest",
                "dependencies": "locked",
                "command": "./vendor/bin/roave-infection-static-analysis-plugin"
            }
        }
    ]
}
