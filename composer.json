{
    "name": "roave/backward-compatibility-check",
    "description": "Tool to compare two revisions of a public API to check for BC breaks",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "azjezz/psl": "^4.2.0",
        "composer/composer": "^2.9.4",
        "nikic/php-parser": "^5.7.0",
        "nikolaposa/version": "^4.2.1",
        "ocramius/package-versions": "^2.11.0",
        "roave/better-reflection": "^6.68.0",
        "symfony/console": "^7.4.3"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "James Titcumb",
            "email": "james@asgrim.com"
        },
        {
            "name": "Marco Pivetta",
            "email": "ocramius@gmail.com"
        }
    ],
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "justinrainbow/json-schema": "^6.6.4",
        "php-standard-library/psalm-plugin": "^2.3.0",
        "phpunit/phpunit": "^12.5.6",
        "psalm/plugin-phpunit": "^0.19.5",
        "roave/infection-static-analysis-plugin": "^1.43.0",
        "roave/security-advisories": "dev-master",
        "squizlabs/php_codesniffer": "^4.0.1",
        "vimeo/psalm": "^6.14.3"
    },
    "conflict": {
        "revolt/event-loop": "<0.2.5",
        "symfony/process": "<5.3.7",
        "marc-mabe/php-enum": "<4.7.2"
    },
    "autoload": {
        "psr-4": {
            "Roave\\BackwardCompatibility\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoaveTest\\BackwardCompatibility\\": "test/unit"
        }
    },
    "bin": [
        "bin/roave-backward-compatibility-check"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
